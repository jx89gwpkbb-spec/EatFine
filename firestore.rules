rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isRestaurantPartner() {
      return hasRole('RESTAURANT_PARTNER');
    }

    function isDeliveryPartner() {
      return hasRole('DELIVERY_PARTNER');
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'email', 'role'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'role'])
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'CUSTOMER';

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string;

      allow delete: if false;
    }

    match /restaurants/{restaurantId} {
      allow read: if true;

      allow create: if isRestaurantPartner();

      allow update: if isRestaurantPartner() && resource.data.ownerUid == request.auth.uid
        || isAdmin();

      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.restaurantOwnerUid == request.auth.uid
        || resource.data.driverUid == request.auth.uid
        || isAdmin()
      );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PLACED';

      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.restaurantOwnerUid == request.auth.uid
        || resource.data.driverUid == request.auth.uid
        || isAdmin()
      );

      allow delete: if false;
    }

    match /reservations/{reservationId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.restaurantOwnerUid == request.auth.uid
        || isAdmin()
      );

      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.restaurantOwnerUid == request.auth.uid
        || isAdmin()
      );
      allow delete: if false;
    }

    match /favorites/{favoriteId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}